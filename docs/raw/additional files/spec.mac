cdef("end_mac", '{
   cdef("","","specfe","delete")
   cdef("user_setpos", "# \\$\\*", "specfe")
   unix("mv /home/bessrc/data/2014/2014-2/NCSU/spec.mac /home/bessrc/data/2014/2014-2/NCSU/spec.mac.bak")
}', "specfe")

cdef("specfe_tweak", '{
   double array twA[MOTORS]
   double array twS[COUNTERS]
   ctim=0.1
   while (1) {
      if(!wait(0x22)){
         get_counts
         count_em ctim
      }
      if(input(-1)!=""){
         local nmot, npos
         aline=input()
         if(sscanf(aline,"mvr %s %g", nmot, npos)==2) {
            waitmove;get_angles;A[motor_num(nmot)]+=(npos)
            move_em
         } else if(sscanf(aline,"mv %s %g", nmot, npos)==2) {
            waitmove;get_angles;A[motor_num(nmot)]=(npos)
            move_em
         } else if(sscanf(aline,"ct %g", ctim)==1) {
         } else if(aline=="") {
            break
         }
      }
      get_angles
      sleep(0.1)
   }
}', "specfe")

cdef("specfe_init_shm", '{
   local i
   shared double array specfe_motors[2][1024]
   shared double array specfe_counters[2][1024]
   get_angles
   for(i=0; i<MOTORS; i++) {
      specfe_motors[0][i]=A[i]
      specfe_motors[1][i]=is_using_motor(i)
      sock_put("localhost:40477",sprintf("#CM%d %g %d\n",i,A[i],is_using_motor(i)))
   }
   for(i=0; i<COUNTERS; i++) {
      specfe_counters[0][i]=S[i]
      specfe_counters[1][i]=is_using_counter(i)
      sock_put("localhost:40477",sprintf("#CC%d %g %d\n",i,S[i],is_using_counter(i)))
   }

   sock_put("localhost:40477",sprintf("#CA %d %d
", eval("return SHMID_specfe_motors"), eval("return SHMID_specfe_counters")))
}', "specfe")

cdef("user_getcounts", '{
   local i,v,u
   for(i=0; i<COUNTERS; i++) {
      v=S[i];u=is_using_counter(i)
      if((specfe_counters[0][i]!=v)||(specfe_counters[1][i]!=u)) {
         specfe_counters[0][i]=v
         specfe_counters[1][i]=u
         sock_put("localhost:40477",sprintf("#CC%d %g %d\n",i,v,u))
      }
   }
}', "specfe", 0x20)

cdef("user_postmove", '{
   read_motors(0)
   local i,v,u
   for(i=0; i<MOTORS; i++) {
      v=A[i];u=is_using_motor(i)
      if((specfe_motors[0][i]!=v)||(specfe_motors[1][i]!=u)) {
         specfe_motors[0][i]=v
         specfe_motors[1][i]=u
         sock_put("localhost:40477",sprintf("#CM%d %g %d\n",i,v,u))
      }
   }
}', "specfe", 0x20)
cdef("user_getangles", '{
   local i,v,u
   for(i=0; i<MOTORS; i++) {
      v=A[i];u=is_using_motor(i)
      if((specfe_motors[0][i]!=v)||(specfe_motors[1][i]!=u)) {
         specfe_motors[0][i]=v
         specfe_motors[1][i]=u
         sock_put("localhost:40477",sprintf("#CM%d %g %d\n",i,v,u))
      }
   }
}', "specfe", 0x20)
